{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.docx",
      "scratch/**"
    ],
    "rewrites": [
      {
        "source": "/registro",
        "destination": "/registro.html"
      },
      {
        "source": "/panel",
        "destination": "/panel.html"
      }
    ]
  }
}
